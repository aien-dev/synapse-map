note ======== xerj (Elasticsearch-compatible) over seed/net/http.om ========
note One connection per request to SXIP:SXPORT (default 127.0.0.1:9200). Request bodies are written into
note gout after any pending output and cut off again before the request is sent. SXST: 0 untried, 1 up,
note 2 down (a connect or protocol failure; later calls skip xerj).

text tget "GET"
text tpost "POST"
text tputm "PUT"
text tdelm "DELETE"
text thost "Host"
text thostv "127.0.0.1"
text tctype "Content-Type"
text tctjson "application/json"
text tctnd "application/x-ndjson"
text tsrchs "/_search?filter_path=hits.hits._id,hits.hits._score"
text tbulks "/_bulk?refresh=true&filter_path=errors"
text tnosfx ""
text tq1 "{\"size\":"
text tq2 ",\"_source\":false,\"query\":{\"bool\":{\"must\":{\"semantic\":{\"field\":\"text\",\"query\":"
text tq3 "}},\"filter\":{\"term\":{\"kind\":\""
text tq4 "\"}}}}}"
text tkrepov "repo"
text tkskill "skill"
text tmapping "{\"mappings\":{\"properties\":{\"kind\":{\"type\":\"keyword\"},\"name\":{\"type\":\"keyword\"},\"text\":{\"type\":\"semantic_text\"}}}}"

note sm_xhttp: method m on "/" index sfx with body gout[bs, SOUT); the response body lands in gfile
note (length SFLEN). Returns the HTTP status, or a negative code.
fn sm_xhttp m view uchar * sfx view uchar * bs ulong to long
cs = new ulong 320 0
io = new uchar 131072 0
d = new uchar 1048576 0
a = new uchar 16 0
tg = new uchar 1024 0
n = sub get gst SOUT bs
put gst SOUT bs
if eq get gst SXST 2
ret -111
end
io2 = get gst SIDXO
il = get gst SIDXL
if gt add add il len sfx 1 len tg
ret -36
end
put tg 0 47
for i ulong il
put tg add i 1 get gpool add io2 i
end
for i ulong len sfx
put tg add add il 1 i get sfx i
end
tn = add add il 1 len sfx
r = haddr4 a uint get gst SXIP get gst SXPORT
fd = hdial a 3000000000
if lt fd 0
put gst SXST 2
ret fd
end
r = hinit cs io int fd 0
hsettmo cs 30000000000 30000000000
r = hfe r hreqst cs io m
r = hfe r hreqtg cs io part tg 0 tn
r = hfe r hhname cs io thost
r = hfe r hhval cs io thostv
if gt n 0
r = hfe r hhname cs io tctype
if eq get gst SCTYP 1
r = hfe r hhval cs io tctnd
else
r = hfe r hhval cs io tctjson
end
end
r = hfe r hhend cs io 0 n
for i ulong n
r = hfe r hputb cs io get gout add bs i
end
r = hfe r hwfin cs io
if lt r 0
c = hclose cs
put gst SXST 2
ret r
end
st = hrsprd cs io
if lt st 0
c = hclose cs
put gst SXST 2
ret st
end
b = hbodyall cs io d
c = hclose cs
if lt b 0
put gst SXST 2
ret b
end
for i ulong ulong b
put gfile i get d i
end
put gst SFLEN ulong b
put gst SXST 1
ret st
end

note sm_xsearch: semantic search of query slice (qo, qn) over documents of kind (0 repo, 1 skill);
note hits into gxr. Returns 0, or a negative code (xerj down, error status, malformed answer).
fn sm_xsearch qo ulong qn ulong kind ulong size ulong to long
put gst SNXR 0
if eq qn 0
ret 0
end
bs = get gst SOUT
sm_ot tq1
sm_on size
sm_ot tq2
sm_oq qo qn
sm_ot tq3
if eq kind 0
sm_ot tkrepov
else
sm_ot tkskill
end
sm_ot tq4
put gst SCTYP 0
st = sm_xhttp tpost tsrchs bs
if lt st 0
ret st
end
if ne st 200
ret -71
end
sm_ot tbx1
sm_otext sm_fo r FREPO sm_fl r FREPO
sm_ob 34
sm_ot tbx2
end
ret 0
end

note sm_xdoc: one bulk action line and document for record r
fn sm_xdoc r ulong to void
sm_ot tbx1
sm_oq sm_fo r FREPO sm_fl r FREPO
sm_ot tbx2
sm_oq sm_fo r FREPO sm_fl r FREPO
sm_ot tbx3
sm_ob 34
sm_otext sm_fo r FREPO sm_fl r FREPO
sm_otext2 tbxsep
sm_otext sm_fo r FPUR sm_fl r FPUR
if gt sm_fl r FLAY 0
sm_otext2 tbxlay
sm_otext sm_fo r FLAY sm_fl r FLAY
end
if gt sm_fl r FTOP 0
sm_otext2 tbxtop
sm_otext sm_fo r FTOP sm_fl r FTOP
end
sm_ob 34
sm_ob 125
sm_ob 10
end

fn sm_otext o ulong n ulong to void
for i ulong n
sm_oesc get gpool add o i
end
end

fn sm_otext2 t view uchar * to void
for i ulong len t
sm_oesc get t i
end
end

text tbx1 "{\"index\":{\"_id\":\"repo:"
text tbx2 "}}\n{\"kind\":\"repo\",\"name\":"
text tbx3 ",\"text\":"
text tbxsep ": "
text tbxlay ". Layer: "
text tbxtop ". Topics: "
text tbs1 "{\"index\":{\"_id\":\"skill:"
text tbs2 "}}\n{\"kind\":\"skill\",\"name\":"

fn sm_xskill s ulong to void
no = get gsk mul s 4
nl = get gsk add mul s 4 1
sm_ot tbs1
sm_otext no nl
sm_ob 34
sm_ot tbs2
sm_oq no nl
sm_ot tbx3
sm_ob 34
sm_otext no nl
sm_otext2 tbxsep
sm_otext get gsk add mul s 4 2 get gsk add mul s 4 3
sm_ob 34
sm_ob 125
sm_ob 10
end

note sm_xindex: drop and recreate the index, then bulk-load records and skills. Returns 0 or negative.
fn sm_xindex to long
bs = get gst SOUT
st = sm_xhttp tdelm tnosfx bs
if lt st 0
ret st
end
sm_ot tmapping
put gst SCTYP 0
st = sm_xhttp tputm tnosfx bs
if lt st 0
ret st
end
if ne st 200
sm_xerrbody
ret -71
end
for r ulong get gst SNREC
sm_xdoc r
end
for s ulong get gst SNSKL
sm_xskill s
end
put gst SCTYP 1
st = sm_xhttp tpost tbulks bs
if lt st 0
ret st
end
if ne st 200
sm_xerrbody
ret -71
end
if not sm_xnoerr
sm_xerrbody
ret -71
end
ret 0
end

text tnoerr "{\"errors\":false}"

fn sm_xnoerr to bool
n = get gst SFLEN
if ne n len tnoerr
ret false
end
for i ulong n
if ne get gfile i get tnoerr i
ret false
end
end
ret true
end

text txerr "synapse-map: xerj answered: "

fn sm_xerrbody to void
sm_err txerr
n = get gst SFLEN
if gt n 400
n = 400
end
k = write 2 gfile 0 n
sm_errnl
end
