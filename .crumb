{
  "schema_version": "1.0.0",
  "name": "synapse-map",
  "purpose": "Repo map for AI lanes: imports the aien-dev catalog and crumbs into map.jsonl with confirmed or inferred parents, answers where-does-this-task-go, checks the tree, scaffolds connected child repos",
  "layer": "coordination",
  "invariants": [
    "stdout is JSONL only; human text goes to stderr",
    "map.jsonl is replaced atomically; parents are CONFIRMED only from a crumb's extensions.map"
  ],
  "extensions": {
    "map": {
      "parent": "aien-dev/synapse@099a980fedab8a6797bbf0358b8c5502c8045142",
      "parent_status": "CONFIRMED"
    }
  }
}
